# ventMail production environment: keys only. The real file is generated on the
# mail box (/srv/apps/ventmail/.env, mode 600, owner deploy) by init-env.sh, and
# late secrets are piped in with set-env.sh. See venture-infra docs/RUNBOOK-mail.md.
# Secrets never enter git, the chat or a log.

# --- application
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=
APP_LOCALE=
APP_FALLBACK_LOCALE=
LOG_CHANNEL=
LOG_LEVEL=
AUDIT_PEPPER=

# --- behind the mail-box edge
TRUSTED_PROXIES=
TRUSTED_HOSTS=
LANDING_HOST=
SESSION_COOKIE=
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=

# --- identity (ventSSO)
OIDC_PROVIDER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
OIDC_ROLES_CLAIM=
IDENTITY_DEV_LOGIN=

# --- redis
REDIS_CLIENT=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
SESSION_DRIVER=
SESSION_LIFETIME=
CACHE_STORE=
QUEUE_CONNECTION=

# --- not part of v1 on this box
BROADCAST_CONNECTION=
SCOUT_DRIVER=
MEILISEARCH_HOST=
INBOUND_ENABLED=
SMTP_SUBMISSION_ENABLED=
MAIL_MAILER=

# --- sending switches (CLOSED by default; only the owner opens them)
SENDING_DRIVER=
SENDING_LIVE=
SENDING_MARKETING_ENABLED=
SEND_ALLOWLIST_ENFORCED=
SEND_ALLOWLIST=
SENDING_DISPATCH_VIA_QUEUE=
SENDING_ALLOW_FAKE_DEPENDENCIES=
SENDING_TRACKING_BASE_URL=
DOMAINS_RESOLVER=

# --- the two Postal instances (one per IP pool)
POSTAL_TX_ENDPOINT=
POSTAL_TX_API_KEY=
POSTAL_TX_WEBHOOK_PUBLIC_KEY=
POSTAL_MK_ENDPOINT=
POSTAL_MK_API_KEY=
POSTAL_MK_WEBHOOK_PUBLIC_KEY=

# --- database (from db.env, written by venture-infra new-app-db.sh)
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=
