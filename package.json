{
    "name": "ventmail",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config vite.report.config.ts",
        "typecheck": "vue-tsc --noEmit",
        "e2e": "playwright test",
        "test:unit": "vitest run",
        "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
    },
    "dependencies": {
