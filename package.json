        "@venture-co-group/ui": "^2.1.1",
        "@venture/sdk": "file:../venture-sdk",
        "@vue-flow/background": "1.3.2",
        "@vue-flow/core": "1.48.2",
        "@vue-flow/minimap": "1.5.4",
        "echarts": "5.6.0",
        "pinia": "^3.0.1",
        "vue": "^3.5.13",
        "vue-echarts": "7.0.3",
        "vue-i18n": "^11.4.10"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@types/node": "^26.4.1",
        "@vitejs/plugin-vue": "^6.0.0",
        "axios": "^1.11.0",
        "happy-dom": "20.14.5",
        "laravel-vite-plugin": "^2.0.0",
        "typescript": "^5.7.2",
        "vite": "^7.0.7",
        "vitest": "4.1.11",
        "vue-tsc": "^2.2.0"
