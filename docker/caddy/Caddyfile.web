# In-image web tier (the `web` role). Plain HTTP on :8080 inside the ventMail
# stack; TLS, HSTS and the public hostnames belong to the mail-box edge.
# Two callers: the edge (public traffic; it never forwards /internal/*) and the
# Postal instances on the internal postal-api network (signed delivery webhooks).
{
	admin off
	auto_https off
	persist_config off
	servers {
		# SLOWLORIS elleni időkorlátok: a fejléc 10 mp, a törzs 10 perc (a 140MB-os import-feltöltés
		# ~0,25 MB/s alatt bukik), az üresjárat 2 perc.
		timeouts {
			read_header 10s
			read_body 10m
			idle 2m
		}
		# Keep the edge's X-Forwarded-* (client IP, https); believed from the
		# edge proxy address only.
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

import snippets/security-headers.caddy

:8080 {
	# deploy.sh drains a colour before stopping it by creating /tmp/ventmail-draining:
	# /up then answers 503, the edge moves traffic to the other colour.
	@draining {
		path /up
		file {
			root /tmp
			try_files /ventmail-draining
		}
	}
	respond @draining "draining" 503

	# BODY-LIMIT útvonalanként: a kontakt-import feltöltés nagy törzset kér (a php.ini post_max_size-nál,
	# 132M, nem szűkebb), minden más útvonal (belépés, /v1, nyilvános űrlap) 16MB-nál megáll — a
	# PHP-limit globális, ezért a határ itt, a Caddyben húzódik; az alkalmazás ugyanezt a
	# `LimitRequestBody` middleware-rel is ellenőrzi.
	@import path /audience/import /audience/import/*
	@other not path /audience/import /audience/import/*
	request_body @import {
		max_size 140MB
	}
	request_body @other {
		max_size 16MB
	}

	root * /app/public
	encode zstd gzip
	import security_headers

	# D227: the public disk (template images, D10) lives on the shared `ventmail-storage-public`
	# volume, mounted read-only at /app/storage/app/public. Plain files only: no PHP ever runs
	# from here, and a missing file is a 404. The images are embedded by mail clients and
	# webmail on other origins, hence a cross-origin resource policy for this path only.
	handle_path /storage/* {
		root * /app/storage/app/public
		header Cross-Origin-Resource-Policy "cross-origin"
		file_server
	}

	php_fastcgi unix//run/php/fpm.sock
	file_server

	log {
		output stdout
		format json
	}
}
