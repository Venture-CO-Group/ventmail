# DEV konfiguráció (a fájlnév is ezt mondja): noindex + Basic Auth (golden rule 11).
# Éles környezet SOHA nem ezt használja — oda saját Caddyfile jön a devops packetben.
#
# A :2020-as belső health-listener Basic Auth NÉLKÜL szolgálja ki a /up-ot, hogy a
# konténer-healthcheck ne kelljen hogy plaintext jelszót tartson (security-review K6).
:80 {
	# A path a PHP-FPM konténerből nézve érvényes (SCRIPT_FILENAME), ezért /var/www/public.
	root * /var/www/public
	encode gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# A dev Basic Auth jelszó-hash env-ből jön, soha nem a repóból:
	#   caddy hash-password --plaintext '<jelszo>'  →  DEV_BASIC_AUTH_HASH
	basic_auth {
		{$DEV_BASIC_AUTH_USER:ventmail} {$DEV_BASIC_AUTH_HASH}
	}

	php_fastcgi app:9000
	file_server
}

# Csak a konténerhálón belül elérhető health-listener (nincs kimappelve a hosztra).
# NEM a 2019, mert azt a Caddy admin API foglalja.
#
# ITT NINCS `php_fastcgi`, ÉS EZ SZÁNDÉKOS.
#
# A `php_fastcgi` implicit `try_files`-t tartalmaz, ami a CADDY konténer fájlrendszerét
# nézi — nem az FPM-ét. Ha a `public/` bind mount a Caddy oldalán nem materializálódik
# (macOS file sharing, egy régebbi képpel indított konténer), a `try_files` semmire nem
# illeszt, a route SOHA nem fut le, és a listener MINDEN útvonalra ÜRES 200-at ad. Mérve:
# `/up`, `/u/{token}` és egy nem létező útvonal is egyaránt `200`, `Content-Length: 0` —
# vagyis a konténer-healthcheck vakon zöld volt, anélkül hogy Laravelt látott volna. Pedig
# ennek a listenernek épp az a dolga, hogy a TELJES láncot (Caddy → FPM → Laravel) mérje.
#
# Ezért a `/up`-ot KÖZVETLENÜL az FPM-nek adjuk át, fájllétezés-ellenőrzés nélkül: a
# `SCRIPT_FILENAME` fixen a front controller, a `REQUEST_URI` pedig érintetlen, tehát a
# Laravel a saját route-ján válaszol. Minden más útvonal 404 — egy health-listener ne
# legyen második, hitelesítés nélküli bejárat az alkalmazásba.
:2020 {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /up {
		reverse_proxy app:9000 {
			transport fastcgi {
				env SCRIPT_FILENAME /var/www/public/index.php
			}
		}
	}

	handle {
		respond 404
	}
}
