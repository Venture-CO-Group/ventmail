# ventMail — környezeti változók. TITOK SOHA NEM KERÜL A REPÓBA.
# Az értékek üresen maradnak; a valódi titkot a .env (gitignore-olt) vagy a secret store adja.

APP_NAME=ventMail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# A kimenő levél a Sending modul SendingDriverén megy (M0-3) — a Laravel mailer csak napló.
MAIL_MAILER=log

# --- PostgreSQL 17 + TimescaleDB ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ventmail
DB_USERNAME=ventmail
DB_PASSWORD=ventmail

# --- Redis / Horizon / cache / session ---------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Reverb (broadcast) -------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# --- Meilisearch --------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Lokális dev master key (127.0.0.1-re kötve). Éles környezetben KÖTELEZŐ felülírni.
MEILISEARCH_KEY=ventmail-dev-key

# --- ventSSO (OIDC) — M0-1 --------------------------------------------------
# Amíg a 'ventmail' kliens nincs regisztrálva, a lokális ventsso példány a provider.
# Amíg a 'ventmail' kliens nincs regisztrálva: a LOKÁLIS ventsso példány (PHASE.md 2. döntés).
OIDC_PROVIDER_URL=http://localhost:8000
OIDC_CLIENT_ID=ventmail
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email roles"
OIDC_ROLES_CLAIM=resource_access.ventmail.roles

# --- Küldés (M0-3) ------------------------------------------------------------
# fake | log | postal — a driver-csere CSAK config, sosem domain-kód.
SENDING_DRIVER=fake

# --- Dev-védelem (golden rule 11: noindex + Basic Auth) -----------------------
# A dev Basic Auth hitelesítő a `docker/caddy.env`-ben él (a compose a gyökér .env-et
# interpolálja, ott a bcrypt hash elromlana). Alap dev jelszó: ventmail-dev.
DEV_BASIC_AUTH_USER=ventmail$2a$14$76Mszcz.2qrzVmNbPBnoou7f6DNyFUY8eUAVY3CVguWz.PQw.bxSm

# --- Külső gazdák (fake, amíg nem élnek) --------------------------------------
VENTPAY_DRIVER=fake
VENTUREOS_SYNC_DRIVER=fake

VITE_APP_NAME="${APP_NAME}"
