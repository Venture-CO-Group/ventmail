# ventMail — környezeti változók. TITOK SOHA NEM KERÜL A REPÓBA.
# Az értékek üresen maradnak; a valódi titkot a .env (gitignore-olt) vagy a secret store adja.

APP_NAME=ventMail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# A Caddy (és élesben a Vultr LB) IP-je vagy CIDR-je, vesszővel elválasztva. `*` csak
# fejlesztésben: élesben a proxy-hálóra kell szűkíteni, különben a kliens hamisíthatja az
# X-Forwarded-For fejlécet (rossz rate-limit kulcs és hamis audit-forrás).
TRUSTED_PROXIES=*
# Élesben `__Host-ventmail_session` (Secure) — http-s fejlesztéshez sima név kell.
SESSION_COOKIE=ventmail_session

APP_URL=http://localhost:8088

# KULCSROTÁCIÓ — a leiratkozó és a nyomkövetési linkek élete ezen múlik.
#
# A kimenő levelekben lévő `/u/{token}` és `/t/{token}` linkek az APP_KEY-jel titkosított
# tokent hordoznak, és a levél HÓNAPOKIG él a címzett postafiókjában. Ha az APP_KEY-t
# lecseréled anélkül, hogy a régit ide bemásolnád, MINDEN korábban kiküldött levél
# leiratkozó linkje elhal — és NÉMÁN: a `/u/` szándékosan nem ad orákulumot, tehát a
# címzett a „leiratkoztál" oldalt látja, miközben semmi nem íródik (GDPR 21.). A
# nyomkövetési linkek 404-et adnak, az `opened`/`clicked` események elvesznek.
#
# Rotáció menete: az ÚJ kulcs az APP_KEY-be, a RÉGI ide (vesszővel több is felsorolható).
# A régit addig tartsd itt, ameddig a leghosszabb kampány-farok tart. Méréssel igazolt: a
# `previous_keys` listával a régi tokenek továbbra is megfejtődnek, nélküle nem.
APP_PREVIOUS_KEYS=

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# A kimenő levél a Sending modul SendingDriverén megy (M0-3) — a Laravel mailer csak napló.
MAIL_MAILER=log

# --- PostgreSQL 17 + TimescaleDB ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ventmail
DB_USERNAME=ventmail
DB_PASSWORD=ventmail
# Lokálisan a db konténer nem ajánl TLS-t; ÉLESBEN a default `require` érvényes.
DB_SSLMODE=disable

# --- Redis / Horizon / cache / session ---------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Devben a Redis loopbackra kötött; ÉLES környezetben a jelszó KÖTELEZŐ — a session-payload
# (OIDC state/nonce/PKCE verifier) is itt tárolódik.
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Az OIDC state/nonce/PKCE verifier a session payloadba kerül (M0-1) — titkosítva tároljuk.
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Devben http://localhost, ezért null; ÉLESBEN KÖTELEZŐEN true.
SESSION_SECURE_COOKIE=null

# --- Reverb (broadcast) -------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# --- Meilisearch --------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Lokális dev master key (127.0.0.1-re kötve). Éles környezetben KÖTELEZŐ felülírni.
MEILISEARCH_KEY=ventmail-dev-key

# --- ventSSO (OIDC) — M0-1 --------------------------------------------------
# Amíg a 'ventmail' kliens nincs regisztrálva, a lokális ventsso példány a provider.
# Amíg a 'ventmail' kliens nincs regisztrálva: a LOKÁLIS ventsso példány (PHASE.md 2. döntés).
OIDC_PROVIDER_URL=http://localhost:8000
OIDC_CLIENT_ID=ventmail
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email roles"
OIDC_ROLES_CLAIM=resource_access.ventmail.roles

# PLATFORM-ADMIN (C2 · 81. kritérium) — KÜLÖN ventSSO-kliens claimje, SZÁNDÉKOSAN nem a
# tenant-szerepek alatt: különben egy workspace-en belül kiosztott `platform_admin` nevű
# szerep platform-hozzáférést adna. A `ventmail-platform` kliens/claim regisztrálása
# EMBERI ventSSO-lépés — amíg nem történt meg, senki nem platform-admin (fail-closed).
OIDC_PLATFORM_ADMIN_CLAIM=resource_access.ventmail-platform.roles
OIDC_PLATFORM_ADMIN_ROLE=platform_admin

# --- Küldés (M0-3) ------------------------------------------------------------
# fake | log | postal — a driver-csere CSAK config, sosem domain-kód.
# Küldési mód. A config alapértéke ZÁRT (éles biztonság); fejlesztésben a fake driverrel nyitva.
SENDING_LIVE=true
SENDING_MARKETING_ENABLED=true
SEND_ALLOWLIST_ENFORCED=false
SEND_ALLOWLIST=
SENDING_DRIVER=fake

# v1.1 sablonszerkesztő képfeltöltés: élesben `null` (alap), fejlesztésben `local`.
TEMPLATE_ASSET_DRIVER=local

# Éles MTA (halasztott ops-sáv): amíg a Postal cluster nem él, üresen marad.
POSTAL_ENDPOINT=
POSTAL_API_KEY=

# PreSendGate 5. kapu — workspace-enkénti küldési sebesség.
SENDING_RATE_LIMIT_PER_MINUTE=300

# PreSendGate 6. kapu — címellenőrzési kockázat (a valódi lánc az A5 packetből jön).
# A nyomkövetés (nyitás-pixel, klikk-átirányítás) HOSZTJA. Elsődlegesen a tenant SAJÁT
# `email.<domain>` CNAME-je szolgálja ki (domain-wizard); ez a platform-szintű tartalék.
# ÜRESEN HAGYVA NINCS NYOMKÖVETÉS — és ez szándékos: az alkalmazás saját domainjén futó
# klikk-átirányító nyílt átirányító lenne azon az originen, ami a session cookie-t szolgálja ki.
SENDING_TRACKING_BASE_URL=

# ── Bejövő (MX) fogadás — A4 ────────────────────────────────────────────────
# Alapból KI: MX-rekord nélkül úgysincs mit fogadni, és egy véletlenül nyitva hagyott
# 25-ös port a legrosszabb fajta meglepetés.
INBOUND_ENABLED=false
INBOUND_HOSTNAME=mx.ventmail.app
# A listener KIZÁRÓLAG ezeken indulhat. A submission portjai (587/465) SZÁNDÉKOSAN nincsenek
# köztük — a két bizalmi modell nem cserélhető fel egy elgépelt kapcsolóval.
INBOUND_ALLOWED_PORTS=25,2525
# A beérkezett levél IDEGEN tartalom: rövid retenció, majd a nyers levél és a csatolmányok is
# törlődnek — az adatbázisból ÉS a fájltárból.
INBOUND_RETENTION_DAYS=3
INBOUND_MAX_MESSAGE_BYTES=26214400
# A SAJÁT `Authentication-Results` azonosítónk: csak az ezzel kezdődő fejlécet olvassuk
# sajátunkként. A küldő által beírt `dkim=pass` hazugság.
INBOUND_AUTHSERV_ID=mx.ventmail.app
# Vírusszűrés. A szkenner FAIL-CLOSED: ha nem elérhető, a csatolmány nem tölthető le.
INBOUND_CLAMAV_DSN=tcp://clamav:3310
# Csatolmány-szkenner: clamav (alap, saját clamd) | ventsec (a ventSec Scan API-ja, fail-closed).
INBOUND_SCANNER=clamav

# --- ventSec-kötés (FO2): m2m token a ventSSO-tól + Scan API + VSES események.
# A kliens-titok és a forrás-HMAC titok: set-env.sh-val érkezik, SOHA nem a repóban.
# Üres VENTSEC_TOKEN_URL = az OIDC-discovery token_endpoint-ja (OIDC_PROVIDER_URL).
VENTSEC_TOKEN_URL=
VENTSEC_CLIENT_ID=
VENTSEC_CLIENT_SECRET=
VENTSEC_RESOURCE=https://sec.ventureco.app
VENTSEC_SCOPE="ventsec.scan ventsec.ingest"
VENTSEC_SCAN_URL=
VENTSEC_SCAN_TIMEOUT=30
VENTSEC_KEYS_URL=
# Biztonsági események (szívverés + katalógus-események). Alapból KI.
VENTSEC_EVENTS_ENABLED=false
VENTSEC_INGEST_URL=
VENTSEC_INGEST_SECRET=
VENTSEC_SOURCE_INSTANCE=
# A nyers levelek és csatolmányok tárolója (Wasabi EU). Külön bucket: idegen tartalom,
# rövid retencióval, SOSEM publikus.
INBOUND_S3_BUCKET=
INBOUND_S3_ENDPOINT=
INBOUND_S3_REGION=eu-central-1

SENDING_VALIDATION_GATE=true
SENDING_VALIDATION_THRESHOLD=0.9

# PreSendGate 4. kapu — amíg a ventPay nem él, innen jön a kvóta.
FAKE_SEND_QUOTA=10000

# --- Dev-védelem (golden rule 11: noindex + Basic Auth) -----------------------
# A dev Basic Auth hitelesítő a `docker/caddy.env`-ben él (a compose a gyökér .env-et
# interpolálja, ott a bcrypt hash elromlana). Alap dev jelszó: ventmail-dev.
DEV_BASIC_AUTH_USER=ventmail

# --- Külső gazdák (fake, amíg nem élnek) --------------------------------------
VENTPAY_DRIVER=fake
VENTUREOS_SYNC_DRIVER=fake

VITE_APP_NAME="${APP_NAME}"

# Kulcsolt hashek pepper-e (API-kulcs, e-mail- és IP-pszeudonimizálás).
# KÜLÖN titok az APP_KEY-től, és KÖTELEZŐ: nélküle az app hangosan megáll.
# Generálás:  php artisan ventmail:pepper
AUDIT_PEPPER=
# Rotáció idejére a KORÁBBI pepper (átfedéses ellenőrzés).
AUDIT_PREVIOUS_PEPPER=

# AZ AUDIT-NAPLÓ RETENCIÓJA napban. A napló megváltoztathatatlan, de nem örök (GDPR
# 5(1)(e)). Az alsó határt (365 nap) a DB-trigger őrzi, nem ez a változó: egy elgépelt
# érték nem törölheti a friss naplót, a `audit:prune` pedig 365 alatt megáll.
AUDIT_RETENTION_DAYS=730

# Fejlesztői belépés a flow-tesztekhez. ÉLESBEN SOHA — külön kapcsoló az APP_ENV mellé.
IDENTITY_DEV_LOGIN=false

# DNS-feloldás: system (éles) | fake (teszt/dev). A fake élesben hangosan elszáll.
DOMAINS_RESOLVER=system

# ── SMTP submission (A2, ADR 0001) ───────────────────────────────────────────
# A listener CSAK titkosított csatornán hitelesít (golden rule 3): tanúsítvány nélkül nem
# indul. Dev-ben öntanúsítvány is elég; élesben a `smtp.ventmail.app` cert kell.
# A küldés SORON menjen-e. Élesben IGEN: a sor a prioritás (transactional > journey >
# campaign) egyetlen érvényesítési helye. Fejlesztésben szinkron, hogy a lefutás
# determinisztikus legyen.
SENDING_DISPATCH_VIA_QUEUE=false

SMTP_SUBMISSION_ENABLED=true
SMTP_HOSTNAME=smtp.ventmail.test
# PROXY protocol: LB mögött KELL, különben minden kapcsolat a balancer IP-jéről érkezik, és
# a per-IP fékek egyetlen közös vödörré válnak. Bekapcsolva a `TRUSTED_SOURCES` KÖTELEZŐ:
# a fejléc csak innen hihető, különben bárki hamisíthatná a forrás-IP-t.
SMTP_PROXY_PROTOCOL=false
SMTP_PROXY_TRUSTED_SOURCES=

# A hitelesítő perces küldési kerete (a workspace-szintű 300/perc fölötte marad).
SMTP_CREDENTIAL_RATE_LIMIT=60

SMTP_TLS_CERT=
SMTP_TLS_KEY=

# ── Ügyeleti riasztás (C2 · 88. kritérium) ───────────────────────────────────
# A blocklist-listázás és a kritikus cluster-állapot NEM e-mailben megy: ha épp a küldés
# a beteg, az e-mail-riasztás sem érne célba. Beállítás nélkül a csatorna néma, és minden
# elmaradt riasztás `error` naplósort ír — de az ügyelet nem tud semmiről.
#
# CSAK PUBLIKUS `https` URL fogadható el (SSRF-őr, átirányítás-követés nélkül).
SUPERADMIN_ONCALL_URL=
SUPERADMIN_ONCALL_SECRET=

# A cluster-health MX-próbájának célja. A listener KÜLÖN konténerben fut (`inbound-mx`),
# tehát nem az app loopbackján keresendő — élesben a valódi MX-hoszt és -port.
INBOUND_HEALTH_HOST=inbound-mx
INBOUND_HEALTH_PORT=2525

# ── ventCookie consent loader (publikus oldalak: apex landing) ────────────────
# Az értékek publikusak, de itt NEM szerepelnek: ventCookie admin → Oldalak → ventmail.app → Beépítés.
# Üres VENTCOOKIE_DOMAIN_TOKEN = a snippet nem renderelődik.
VENTCOOKIE_DOMAIN_TOKEN=
VENTCOOKIE_LOADER_SRC=https://cookie.ventureco.app/cdn/v1/loader.js
VENTCOOKIE_LOADER_SRI=
VENTCOOKIE_SITE_VERIFICATION=
