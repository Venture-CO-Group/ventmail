# ventMail — környezeti változók. TITOK SOHA NEM KERÜL A REPÓBA.
# Az értékek üresen maradnak; a valódi titkot a .env (gitignore-olt) vagy a secret store adja.

APP_NAME=ventMail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# A Caddy (és élesben a Vultr LB) IP-je vagy CIDR-je, vesszővel elválasztva. `*` csak
# fejlesztésben: élesben a proxy-hálóra kell szűkíteni, különben a kliens hamisíthatja az
# X-Forwarded-For fejlécet (rossz rate-limit kulcs és hamis audit-forrás).
TRUSTED_PROXIES=*

APP_URL=http://localhost:8088

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# A kimenő levél a Sending modul SendingDriverén megy (M0-3) — a Laravel mailer csak napló.
MAIL_MAILER=log

# --- PostgreSQL 17 + TimescaleDB ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ventmail
DB_USERNAME=ventmail
DB_PASSWORD=ventmail
# Lokálisan a db konténer nem ajánl TLS-t; ÉLESBEN a default `require` érvényes.
DB_SSLMODE=disable

# --- Redis / Horizon / cache / session ---------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Devben a Redis loopbackra kötött; ÉLES környezetben a jelszó KÖTELEZŐ — a session-payload
# (OIDC state/nonce/PKCE verifier) is itt tárolódik.
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Az OIDC state/nonce/PKCE verifier a session payloadba kerül (M0-1) — titkosítva tároljuk.
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Devben http://localhost, ezért null; ÉLESBEN KÖTELEZŐEN true.
SESSION_SECURE_COOKIE=null

# --- Reverb (broadcast) -------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# --- Meilisearch --------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Lokális dev master key (127.0.0.1-re kötve). Éles környezetben KÖTELEZŐ felülírni.
MEILISEARCH_KEY=ventmail-dev-key

# --- ventSSO (OIDC) — M0-1 --------------------------------------------------
# Amíg a 'ventmail' kliens nincs regisztrálva, a lokális ventsso példány a provider.
# Amíg a 'ventmail' kliens nincs regisztrálva: a LOKÁLIS ventsso példány (PHASE.md 2. döntés).
OIDC_PROVIDER_URL=http://localhost:8000
OIDC_CLIENT_ID=ventmail
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email roles"
OIDC_ROLES_CLAIM=resource_access.ventmail.roles

# --- Küldés (M0-3) ------------------------------------------------------------
# fake | log | postal — a driver-csere CSAK config, sosem domain-kód.
SENDING_DRIVER=fake

# Éles MTA (halasztott ops-sáv): amíg a Postal cluster nem él, üresen marad.
POSTAL_ENDPOINT=
POSTAL_API_KEY=

# PreSendGate 5. kapu — workspace-enkénti küldési sebesség.
SENDING_RATE_LIMIT_PER_MINUTE=300

# PreSendGate 6. kapu — címellenőrzési kockázat (a valódi lánc az A5 packetből jön).
# A nyomkövetés (nyitás-pixel, klikk-átirányítás) HOSZTJA. Elsődlegesen a tenant SAJÁT
# `email.<domain>` CNAME-je szolgálja ki (domain-wizard); ez a platform-szintű tartalék.
# ÜRESEN HAGYVA NINCS NYOMKÖVETÉS — és ez szándékos: az alkalmazás saját domainjén futó
# klikk-átirányító nyílt átirányító lenne azon az originen, ami a session cookie-t szolgálja ki.
SENDING_TRACKING_BASE_URL=

SENDING_VALIDATION_GATE=true
SENDING_VALIDATION_THRESHOLD=0.9

# PreSendGate 4. kapu — amíg a ventPay nem él, innen jön a kvóta.
FAKE_SEND_QUOTA=10000

# --- Dev-védelem (golden rule 11: noindex + Basic Auth) -----------------------
# A dev Basic Auth hitelesítő a `docker/caddy.env`-ben él (a compose a gyökér .env-et
# interpolálja, ott a bcrypt hash elromlana). Alap dev jelszó: ventmail-dev.
DEV_BASIC_AUTH_USER=ventmail

# --- Külső gazdák (fake, amíg nem élnek) --------------------------------------
VENTPAY_DRIVER=fake
VENTUREOS_SYNC_DRIVER=fake

VITE_APP_NAME="${APP_NAME}"

# Kulcsolt hashek pepper-e (API-kulcs, e-mail- és IP-pszeudonimizálás).
# KÜLÖN titok az APP_KEY-től, és KÖTELEZŐ: nélküle az app hangosan megáll.
# Generálás:  php artisan ventmail:pepper
AUDIT_PEPPER=
# Rotáció idejére a KORÁBBI pepper (átfedéses ellenőrzés).
AUDIT_PREVIOUS_PEPPER=

# Fejlesztői belépés a flow-tesztekhez. ÉLESBEN SOHA — külön kapcsoló az APP_ENV mellé.
IDENTITY_DEV_LOGIN=false

# DNS-feloldás: system (éles) | fake (teszt/dev). A fake élesben hangosan elszáll.
DOMAINS_RESOLVER=system

# ── SMTP submission (A2, ADR 0001) ───────────────────────────────────────────
# A listener CSAK titkosított csatornán hitelesít (golden rule 3): tanúsítvány nélkül nem
# indul. Dev-ben öntanúsítvány is elég; élesben a `smtp.ventmail.app` cert kell.
# A küldés SORON menjen-e. Élesben IGEN: a sor a prioritás (transactional > journey >
# campaign) egyetlen érvényesítési helye. Fejlesztésben szinkron, hogy a lefutás
# determinisztikus legyen.
SENDING_DISPATCH_VIA_QUEUE=false

SMTP_SUBMISSION_ENABLED=true
SMTP_HOSTNAME=smtp.ventmail.test
# PROXY protocol: LB mögött KELL, különben minden kapcsolat a balancer IP-jéről érkezik, és
# a per-IP fékek egyetlen közös vödörré válnak. Bekapcsolva a `TRUSTED_SOURCES` KÖTELEZŐ:
# a fejléc csak innen hihető, különben bárki hamisíthatná a forrás-IP-t.
SMTP_PROXY_PROTOCOL=false
SMTP_PROXY_TRUSTED_SOURCES=

# A hitelesítő perces küldési kerete (a workspace-szintű 300/perc fölötte marad).
SMTP_CREDENTIAL_RATE_LIMIT=60

SMTP_TLS_CERT=
SMTP_TLS_KEY=
