<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <!--
      A socket-tesztek portot foglalnak és külön processzt indítanak: a párhuzamos alap
      futásból kizárva, a CI külön, SOROS jobban futtatja őket (group: smtp-socket).
      Így a 11. kritériumnak van valódi, hálózati bizonyítéka anélkül, hogy a napi
      teszt-futás flaky lenne.

      Ugyanez a Timescale FOLYTONOS AGGREGÁTUM tesztjeire (group: timescale). Ezek
      `DatabaseMigrations`-szel futnak — a `refresh_continuous_aggregate` nem mehet
      tranzakción belül —, tehát tesztenként le is bontják a sémát. A materializált nézet
      eldobása közben a Postgres katalógusa versenyez a párhuzamos workerekkel:
      „tuple concurrently deleted", nagyjából minden harmadik futásban. A megoldás nem az
      újrapróbálás, hanem az, hogy ez a teszt EGYEDÜL kapja a sémát.
    -->
    <groups>
        <exclude>
            <group>smtp-socket</group>
            <group>timescale</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
          A TESZT-PROCESSZ MEMÓRIA-LIMITJE az ÉLES WORKERÉVEL egyezik (a compose is 512M).

          Miért kell kimondani: a bejövő MIME-parser plafonja a PROCESSZ `memory_limit`-jéhez
          igazodik (`InboundMimeParser::ceiling()`), és HANGOSAN elbukik, ha a maradék
          headroom kevés — ez helyes viselkedés, csak a SOROS teszt-futásban félrevezető: a
          PHPUnit halmozza a memóriát, tehát ~1500 teszt után a 128M-os alapon a parser
          minden bejövő tesztnél „nincs elég memória" hibát ad, miközben a kód jó (mérve: 34
          teszt bukott így, párhuzamosan mind zöld volt).

          A limit tehát nem a tesztet gyengíti, hanem a futtatókörnyezetet igazítja ahhoz,
          amit a `docker-compose` a workernek ad. A parser saját plafon-logikáját külön,
          EXPLICIT `memory_limit`-et állító tesztek fedik.
        -->
        <ini name="memory_limit" value="512M"/>
        <env force="true" name="APP_ENV" value="testing"/>
        <env force="true" name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env force="true" name="BCRYPT_ROUNDS" value="4"/>
        <env force="true" name="BROADCAST_CONNECTION" value="null"/>
        <env force="true" name="CACHE_STORE" value="array"/>
        <!-- A teszt VALÓDI PostgreSQL 17 + TimescaleDB ellen fut (dev és CI ugyanaz az image). -->
        <env force="true" name="DB_CONNECTION" value="pgsql"/>
        <env force="true" name="DB_DATABASE" value="ventmail_test"/>
        <!-- A dev/CI Postgres nem ajánl TLS-t; éles környezetben a `require` az alapértelmezés. -->
        <env force="true" name="DB_SSLMODE" value="disable"/>
        <!-- A teszt SOHA nem kérdezhet valódi DNS-t: determinisztikus fake resolver. -->
        <env force="true" name="DOMAINS_RESOLVER" value="fake"/>
        <env force="true" name="IDENTITY_DEV_LOGIN" value="true"/>
        <env name="DB_URL" value=""/>
        <env force="true" name="MAIL_MAILER" value="array"/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- A Laravel env-feloldásában a $_SERVER nyer, a PHPUnit <env> viszont csak a $_ENV-et
             írja. A konténerben a compose env_file valódi környezeti változóként adja át a
             .env-et, ezért ugyanezeket $_SERVER-en is felül kell írni — különben a teszt a
             DEV drivereken futna (Redis-cache, Redis-session), és a rate limiter átszivárogna
             a tesztek között. -->
        <server force="true" name="APP_ENV" value="testing"/>
        <server force="true" name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server force="true" name="BCRYPT_ROUNDS" value="4"/>
        <server force="true" name="BROADCAST_CONNECTION" value="null"/>
        <server force="true" name="CACHE_STORE" value="array"/>
        <server force="true" name="DB_CONNECTION" value="pgsql"/>
        <server force="true" name="DB_DATABASE" value="ventmail_test"/>
        <server force="true" name="DB_SSLMODE" value="disable"/>
        <server force="true" name="DOMAINS_RESOLVER" value="fake"/>
        <server force="true" name="IDENTITY_DEV_LOGIN" value="true"/>
        <server force="true" name="MAIL_MAILER" value="array"/>
        <server force="true" name="QUEUE_CONNECTION" value="sync"/>
        <server force="true" name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
